# Обов'язкові значення для бота
TELEGRAM_BOT_TOKEN=
API_TOKEN=
NETALERTX_URL=http://host.docker.internal:20212
REFERENCE_MAC=
ADMIN_USER_IDS=
MEMBER_USER_IDS=
ALLOWED_GROUP_IDS=

# Порожньо: перший адміністратор, нові MAC та гості за маршрутом адміністратора
ADMIN_CHAT_ID=
DISCOVERY_CHAT_ID=
GUEST_CHAT_ID=

POLL_SECONDS=30
# Відповідає ARPSCAN_RUN_SCHD = * * * * * для однієї домашньої підмережі
SCAN_SECONDS=60
MAX_SCAN_GAP_SECONDS=
API_TIMEOUT_SECONDS=10
POSITIVE_SCANS=2
OFFLINE_SECONDS=300
REMINDER_ABSENCE_SECONDS=600
REMINDER_QUIET_SECONDS=1200
ANNOUNCE_INITIAL_DEVICES=false

BOT_IMAGE=home-presence-bot:1
# Лише для окремого стеку NetAlertX
NETALERTX_WEB_PORT=20211
NETALERTX_API_PORT=20212
NETALERTX_LISTEN_ADDR=127.0.0.1
