# Обов'язкові значення для бота
TELEGRAM_BOT_TOKEN=
TENDA_URL=http://192.168.0.1
# Передайте TENDA_PASSWORD через середовище Docker Compose або Portainer.
ADMIN_USER_IDS=
MEMBER_USER_IDS=
ALLOWED_GROUP_IDS=

# Порожньо: перший адміністратор, нові MAC та гості за маршрутом адміністратора
ADMIN_CHAT_ID=
DISCOVERY_CHAT_ID=
GUEST_CHAT_ID=

API_TIMEOUT_SECONDS=10
POSITIVE_CHECKS=2
OFFLINE_SECONDS=300
REMINDER_ABSENCE_SECONDS=600
REMINDER_QUIET_SECONDS=1200
ANNOUNCE_INITIAL_DEVICES=false

BOT_IMAGE=home-presence-bot:2
